    <declare-styleable name="StatusBadgeView">
        <attr name="statusBadgeColor" format="color" />
        <attr name="statusBadgeTextColor" format="color" />
        <attr name="statusBadgeCornerRadius" format="dimension" />
    </declare-styleable>
</resources>
